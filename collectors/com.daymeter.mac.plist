<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.daymeter.mac</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/SHARED/daymeter/collectors/mac.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DAYMETER_INGEST_URL</key>
    <string>https://daymeter.vercel.app/api/ingest</string>
    <key>DAYMETER_INGEST_TOKEN</key>
    <string>replace-me</string>
  </dict>
</dict>
</plist>
